{
  "manifest_version": 3,
  "name": "PokerNow Algo Bot",
  "version": "0.8.0",
  "description": "Local No Limit Hold'em analysis and optional automation for PokerNow tables.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://www.pokernow.com/games/*", "https://pokernow.com/games/*"],
    "js": ["config.js", "core.js", "strategy.js", "adapter.js", "safety.js", "bot.js"],
    "run_at": "document_idle"
  }]
}
